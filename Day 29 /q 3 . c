#include <stdio.h>
#include <string.h>

int main() {

    char str1[100], str2[100], copy[100];
    int choice;

    printf("Enter first string: ");
    scanf("%s", str1);

    printf("Enter second string: ");
    scanf("%s", str2);

    while(1){

        printf("\n===== String Operations =====\n");
        printf("1. Length\n");
        printf("2. Copy\n");
        printf("3. Concatenate\n");
        printf("4. Compare\n");
        printf("5. Exit\n");
        printf("Enter choice: ");
        scanf("%d",&choice);

        if(choice==5)
            break;

        switch(choice){

        case 1:
            printf("Length = %lu\n", strlen(str1));
            break;

        case 2:
            strcpy(copy,str1);
            printf("Copied String = %s\n",copy);
            break;

        case 3:
            strcpy(copy,str1);
            strcat(copy,str2);
            printf("Concatenated String = %s\n",copy);
            break;

        case 4:
            if(strcmp(str1,str2)==0)
                printf("Strings are Equal\n");
            else
                printf("Strings are Not Equal\n");
            break;

        default:
            printf("Invalid Choice!\n");
        }
    }

    return 0;
}
