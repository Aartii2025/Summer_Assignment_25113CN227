#include <stdio.h>

int main() {
    int ans, score = 0;

    printf("===== QUIZ =====\n");

    printf("\nQ1. Capital of India?\n");
    printf("1. Mumbai\n2. Delhi\n3. Chennai\n4. Kolkata\n");
    printf("Answer: ");
    scanf("%d", &ans);

    if (ans == 2)
        score++;

    printf("\nQ2. 5 + 3 = ?\n");
    printf("1. 6\n2. 7\n3. 8\n4. 9\n");
    printf("Answer: ");
    scanf("%d", &ans);

    if (ans == 3)
        score++;

    printf("\nQ3. C language was developed by?\n");
    printf("1. Dennis Ritchie\n2. James Gosling\n3. Bjarne Stroustrup\n4. Guido van Rossum\n");
    printf("Answer: ");
    scanf("%d", &ans);

    if (ans == 1)
        score++;

    printf("\nYour Score = %d/3\n", score);

    if (score == 3)
        printf("Excellent!\n");
    else if (score == 2)
        printf("Good Job!\n");
    else
        printf("Better Luck Next Time!\n");

    return 0;
}
