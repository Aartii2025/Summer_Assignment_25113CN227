#include <stdio.h>

int main()
{
    int empId;
    float basic, hra, da, total;

    printf("Enter Employee ID: ");
    scanf("%d", &empId);

    printf("Enter Basic Salary: ");
    scanf("%f", &basic);

    hra = basic * 0.20;
    da = basic * 0.10;

    total = basic + hra + da;

    printf("\n----- Salary Details -----\n");
    printf("Employee ID : %d\n", empId);
    printf("Basic Salary: %.2f\n", basic);
    printf("HRA         : %.2f\n", hra);
    printf("DA          : %.2f\n", da);
    printf("Total Salary: %.2f\n", total);

    return 0;
}
