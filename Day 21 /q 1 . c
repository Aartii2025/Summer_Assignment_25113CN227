#include <stdio.h>

int main() {
    char str[100];
    int i = 0, length = 0;

    printf("Enter a string: ");
    fgets(str, sizeof(str), stdin);

    while (str[i] != '\0') {
        if (str[i] != '\n')   // newline ko count nahi karenge
            length++;
        i++;
    }

    printf("Length of string = %d", length);

    return 0;
}
