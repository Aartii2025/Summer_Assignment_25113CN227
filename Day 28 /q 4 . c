#include <stdio.h>

struct Contact
{
    char name[30];
    char phone[15];
};

int main()
{
    struct Contact c[50];
    int n=0, choice, i;

    do
    {
        printf("\n--- Contact Management System ---\n");
        printf("1. Add Contact\n");
        printf("2. Display Contacts\n");
        printf("3. Exit\n");

        printf("Enter choice: ");
        scanf("%d",&choice);

        switch(choice)
        {
            case 1:
                printf("Enter Name: ");
                scanf("%s", c[n].name);

                printf("Enter Phone Number: ");
                scanf("%s", c[n].phone);

                n++;
                printf("Contact Added Successfully.\n");
                break;

            case 2:
                printf("\nName\t\tPhone\n");
                for(i=0;i<n;i++)
                {
                    printf("%s\t\t%s\n", c[i].name, c[i].phone);
                }
                break;

            case 3:
                printf("Thank You!\n");
                break;

            default:
                printf("Invalid Choice\n");
        }

    }while(choice!=3);

    return 0;
}
