#include <stdio.h>

int main()
{
    int seats = 10;
    int choice, n;

    do
    {
        printf("\n--- Ticket Booking System ---\n");
        printf("1. Check Available Seats\n");
        printf("2. Book Ticket\n");
        printf("3. Exit\n");

        printf("Enter choice: ");
        scanf("%d",&choice);

        switch(choice)
        {
            case 1:
                printf("Available Seats = %d\n", seats);
                break;

            case 2:
                printf("Enter Number of Tickets: ");
                scanf("%d",&n);

                if(n<=seats)
                {
                    seats -= n;
                    printf("Booking Successful.\n");
                    printf("Remaining Seats = %d\n", seats);
                }
                else
                {
                    printf("Seats Not Available.\n");
                }
                break;

            case 3:
                printf("Thank You!\n");
                break;

            default:
                printf("Invalid Choice\n");
        }

    }while(choice!=3);

    return 0;
}
