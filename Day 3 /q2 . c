#include<stdio.h>
int main ()
  {
      int num , i , j , start,flag , end ;
      printf("Enter the starting number :  \n");
      scanf("%d" , &start);
      printf("Enter the ending number : \n" );
      scanf ("%d" ,&end);
      printf("Prime numbers in range are \n ");
      for (i = start ; i <= end ; i++){
      if(i <= 1) 
      { 
          continue;

      }
      flag = 1;
      
      for ( j = 2; j < i; j++) {
          if ( i % j == 0) {
              flag = 0 ;
              break ;
          }
      }
      if ( flag == 1) {
          printf ("%d \n" , i) ;
      }
          
      } 
      return 0;
  }
