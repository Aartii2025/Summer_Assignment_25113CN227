#include <stdio.h>
#include <string.h>

struct Book
{
    int id;
    char name[50];
};

int main()
{
    struct Book b[100];
    int n = 0, choice, i;

    while (1)
    {
        printf("\n===== MINI LIBRARY SYSTEM =====\n");
        printf("1. Add Book\n");
        printf("2. Display Books\n");
        printf("3. Exit\n");

        printf("Enter Choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
        case 1:
            printf("Enter Book ID: ");
            scanf("%d", &b[n].id);

            printf("Enter Book Name: ");
            scanf("%s", b[n].name);

            n++;
            printf("Book Added Successfully!\n");
            break;

        case 2:
            printf("\nID\tBook Name\n");
            for (i = 0; i < n; i++)
            {
                printf("%d\t%s\n", b[i].id, b[i].name);
            }
            break;

        case 3:
            return 0;

        default:
            printf("Invalid Choice!\n");
        }
    }
}
