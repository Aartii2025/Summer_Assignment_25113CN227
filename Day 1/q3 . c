#include <stdio.h>

int main() {
    int num, i , fact = 1;
    printf("Enter the number ");
    scanf ("%d" , &num);
    printf("Factorial of a number is %d" , fact);
    for (i = 1; i < num; i++){
        fact = fact * i ;
    }
    printf("factorial of %d = %d" , fact, num);
     return 0;
}
    
