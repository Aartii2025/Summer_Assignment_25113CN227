#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;

    int arr[n];

    for(int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    int key;
    cin >> key;

    int start = 0;
    int end = n - 1;
    int found = 0;

    while(start <= end) {
        int mid = (start + end) / 2;

        if(arr[mid] == key) {
            cout << "Element found at index " << mid;
            found = 1;
            break;
        }
        else if(arr[mid] < key) {
            start = mid + 1;
        }
        else {
            end = mid - 1;
        }
    }

    if(found == 0) {
        cout << "Element not found";
    }

    return 0;
}
